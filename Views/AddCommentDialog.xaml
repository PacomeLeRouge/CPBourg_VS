<UserControl x:Class="CPBourg.NextGenGui.Views.AddCommentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <Grid>
        <Border Background="{StaticResource OverlayScrimBrush}" MouseDown="OnScrimMouseDown" />

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16"
                Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource StatusIdleBgBrush}">
                        <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{StaticResource JobsAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Add Comment" FontSize="20" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            Click="OnCloseClick">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Text="Add or update a comment for the selected job." FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,20" TextWrapping="Wrap" />

                <TextBlock Text="Selected Job" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <Border Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="JobNameText" Text="-" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Comment" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="Maximum: 4 lines" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                </Grid>
                <Border Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <TextBox x:Name="CommentTextBox" Background="Transparent" BorderThickness="0"
                             Padding="12,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxLines="4" Height="90" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" MinHeight="52" Click="OnCancelClick">
                        <TextBlock Text="Cancel" FontSize="15" FontWeight="Medium" />
                    </Button>
                    <Button Grid.Column="2" MinHeight="52" Background="{StaticResource JobsAccentBrush}"
                            Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                            Click="OnSaveClick">
                        <TextBlock Text="Save Comment" FontSize="15" FontWeight="Medium" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
