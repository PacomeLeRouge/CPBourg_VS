<UserControl x:Class="CPBourg.NextGenGui.Views.OpenJobDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- No success confirmation for this one - the reference mock doesn't
         show one for Open Job (unlike Add Comment / Save As New / Remove).
         Closing this dialog is the whole flow; JobsView shows a small stub
         feedback line, same as the other action buttons. -->

    <Grid>
        <Border Background="{StaticResource OverlayScrimBrush}" MouseDown="OnScrimMouseDown" />

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16"
                Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource StatusIdleBgBrush}">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{StaticResource JobsAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Open Job" FontSize="20" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            Click="OnCloseClick">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Text="Open the selected job and load its settings." FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,20" TextWrapping="Wrap" />

                <TextBlock Text="Selected Job" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <Border Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="JobNameText" Text="-" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Format" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <Border Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="JobFormatText" Text="-" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBorderBrush}" Height="1" Margin="0,0,0,16" />

                <TextBlock Text="RUN ADJUSTMENTS" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource JobsAccentBrush}" Margin="0,0,0,10" />
                <CheckBox x:Name="LoadRunAdjustmentsCheckBox" Margin="0,0,0,24">
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Load saved RUN adjustments" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Apply the saved RUN adjustments for this job." FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </CheckBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" MinHeight="52" Click="OnCancelClick">
                        <TextBlock Text="Cancel" FontSize="15" FontWeight="Medium" />
                    </Button>
                    <Button Grid.Column="2" MinHeight="52" Background="{StaticResource JobsAccentBrush}"
                            Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                            Click="OnOpenClick">
                        <TextBlock Text="Open Job" FontSize="15" FontWeight="Medium" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
