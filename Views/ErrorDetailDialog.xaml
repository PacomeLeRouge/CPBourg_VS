<UserControl x:Class="CPBourg.NextGenGui.Views.ErrorDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- Shown when a row in ErrorsView's Active Messages list is clicked.
         Two-column layout matching the reference: Severity/Source/Related
         Module/Related Job on the left, Description on the right, divided
         by a vertical rule. Close dismisses without changes; Clear removes
         just this one message and closes. -->

    <Grid>
        <Border Background="{StaticResource OverlayScrimBrush}" MouseDown="OnScrimMouseDown" />

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16"
                Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SeverityIconBg" Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                            Background="{StaticResource StatusErrorBgBrush}">
                        <TextBlock x:Name="SeverityIconText" Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="24" Foreground="{StaticResource StatusErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Error: -" FontSize="19" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Top" Click="OnCloseClick">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Severity" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <Border x:Name="SeverityBadge" Background="{StaticResource StatusErrorBgBrush}"
                                CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock x:Name="SeverityBadgeText" Text="Critical" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource StatusErrorBrush}" />
                        </Border>

                        <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="SourceText" Text="-" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Related Module" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="RelatedModuleText" Text="-" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Related Job" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="RelatedJobText" Text="-" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource CardBorderBrush}" />

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="DescriptionText" Text="-" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource CardBorderBrush}" Height="1" Margin="0,24,0,20" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" MinHeight="52" Click="OnCloseClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Close" FontSize="15" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" MinHeight="52" Background="{StaticResource JobsAccentBrush}"
                            Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                            Click="OnClearClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       Foreground="{StaticResource JobsAccentForegroundBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Clear" FontSize="15" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
