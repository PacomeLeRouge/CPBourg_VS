<UserControl x:Class="CPBourg.NextGenGui.Views.StfoConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CPBourg.NextGenGui.Views"
             Background="{StaticResource ScreenBackgroundBrush}">

    <!--
        Individual Machine Configuration - STFO (booklet maker) job settings.

        Reached from the Home dashboard by tapping the STFO machine tile (see
        DashboardView.NavigateToStfoRequested -> MainWindow.NavigateToStfo).
        A five-step wizard - Menu / Stitching / Folding / Trimming / Conveyor.

        The step tab bar and the Status / Machine / Job strip are shared by
        every step. Step 1 (Menu) and steps 3-5 (not yet built) show the
        machine-line overview; step 2 (Stitching) shows the interactive
        stitching form (right) driving a live preview (left) that reflects the
        chosen paper size, stitch mode, spacing and offsets - see the
        RedrawStitchPreview code-behind. Everything is local; there is no WFM
        connection in this build.

        ICON NOTE: glyphs reuse Segoe MDL2 Assets codepoints already used
        elsewhere - ChevronLeft/Right (E76B/E76C), Refresh (E72C), Save
        (E74E), document (E8A5). Stitch-mode and summary icons are drawn as
        small vector shapes rather than guessing new glyph codepoints.

        COLOUR NOTE: navy (HeaderBackgroundBrush) marks the active step / Save;
        the app blue (JobsAccentBrush) marks the selected stitch mode. The
        illustrations use existing theme tokens so they re-skin with the app.
    -->

    <UserControl.Resources>

        <Style x:Key="StepTabButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource OutlineButtonBorderBrush}" BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ScreenBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryFooterButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource HeaderTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Numeric parameter field. -->
        <Style x:Key="NumberBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource JobsAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stitch-mode selector tile. Selected state (blue border/fill/label)
             is applied in code-behind (RefreshStitchModeButtons). -->
        <Style x:Key="StitchModeButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="6,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="UnitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <!-- Segmented choice button (Fold Function, Pressure Mode). Selected
             state (blue fill / white text) is applied in code-behind. -->
        <Style x:Key="ChoiceButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper +/- button. -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource OutlineButtonBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ScreenBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal horizontal slider: rounded track + round thumb. -->
        <Style x:Key="LineSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource ProgressTrackBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource HeaderBackgroundBrush}"
                                                         Stroke="{StaticResource CardBackgroundBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Step tab bar ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="6">
            <UniformGrid Columns="5">
                <Button x:Name="StepTab0" Style="{StaticResource StepTabButtonStyle}" Content="1. Menu" Click="OnStepTabClick" Tag="0" />
                <Button x:Name="StepTab1" Style="{StaticResource StepTabButtonStyle}" Content="2. Stitching" Click="OnStepTabClick" Tag="1" />
                <Button x:Name="StepTab2" Style="{StaticResource StepTabButtonStyle}" Content="3. Folding" Click="OnStepTabClick" Tag="2" />
                <Button x:Name="StepTab3" Style="{StaticResource StepTabButtonStyle}" Content="4. Trimming" Click="OnStepTabClick" Tag="3" />
                <Button x:Name="StepTab4" Style="{StaticResource StepTabButtonStyle}" Content="5. Conveyor" Click="OnStepTabClick" Tag="4" />
            </UniformGrid>
        </Border>

        <!-- ================= Status / Machine / Job strip ================= -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" FontSize="20" VerticalAlignment="Center">
                        <Run Text="Status: " FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource CardBorderBrush}" Width="1" Margin="0,2" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource StatusRunningBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" FontSize="20" VerticalAlignment="Center">
                        <Run Text="Machine: " FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Background="{StaticResource CardBorderBrush}" Width="1" Margin="0,2" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                               Foreground="{StaticResource JobsAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" FontSize="20" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="Job: " FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run x:Name="CurrentJobNameRun" Text="[Job Name]" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Per-step content ================= -->
        <Grid Grid.Row="4">

            <!-- ===== Overview (Menu + not-yet-built steps): machine line ===== -->
            <Border x:Name="OverviewContent" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Live Preview" FontSize="17" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid Grid.Row="1">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="640" Height="300">
                                <Ellipse Canvas.Left="95" Canvas.Top="258" Width="22" Height="22" Fill="{StaticResource TextSecondaryBrush}" />
                                <Ellipse Canvas.Left="225" Canvas.Top="258" Width="22" Height="22" Fill="{StaticResource TextSecondaryBrush}" />
                                <Rectangle Canvas.Left="70" Canvas.Top="120" Width="200" Height="145" RadiusX="8" RadiusY="8"
                                           Fill="{StaticResource CardBorderBrush}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" />
                                <Rectangle Canvas.Left="95" Canvas.Top="165" Width="70" Height="10" RadiusX="4" RadiusY="4" Fill="{StaticResource TextMutedBrush}" />
                                <Rectangle Canvas.Left="95" Canvas.Top="200" Width="70" Height="10" RadiusX="4" RadiusY="4" Fill="{StaticResource TextMutedBrush}" />
                                <Rectangle Canvas.Left="150" Canvas.Top="92" Width="8" Height="32" Fill="{StaticResource TextMutedBrush}" />
                                <Rectangle Canvas.Left="118" Canvas.Top="62" Width="74" Height="44" RadiusX="4" RadiusY="4" Fill="{StaticResource HeaderBackgroundBrush}" />
                                <Ellipse Canvas.Left="315" Canvas.Top="258" Width="22" Height="22" Fill="{StaticResource TextSecondaryBrush}" />
                                <Ellipse Canvas.Left="470" Canvas.Top="258" Width="22" Height="22" Fill="{StaticResource TextSecondaryBrush}" />
                                <Rectangle Canvas.Left="278" Canvas.Top="128" Width="250" Height="137" RadiusX="8" RadiusY="8" Fill="{StaticResource TextSecondaryBrush}" />
                                <Rectangle Canvas.Left="290" Canvas.Top="112" Width="80" Height="28" RadiusX="6" RadiusY="6" Fill="{StaticResource TextMutedBrush}" />
                                <Ellipse Canvas.Left="452" Canvas.Top="182" Width="52" Height="52" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="3" Fill="Transparent" />
                                <Ellipse Canvas.Left="470" Canvas.Top="200" Width="16" Height="16" Fill="{StaticResource TextMutedBrush}" />
                                <Rectangle Canvas.Left="430" Canvas.Top="90" Width="8" Height="40" Fill="{StaticResource TextMutedBrush}" />
                                <Rectangle Canvas.Left="398" Canvas.Top="58" Width="78" Height="50" RadiusX="4" RadiusY="4" Fill="{StaticResource HeaderBackgroundBrush}" />
                                <Rectangle Canvas.Left="528" Canvas.Top="185" Width="100" Height="22" RadiusX="3" RadiusY="3" Fill="{StaticResource TextSecondaryBrush}" />
                                <Rectangle Canvas.Left="528" Canvas.Top="178" Width="100" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource TextMutedBrush}" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock x:Name="StepCaptionText" Text="" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                   Margin="0,0,0,4" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Stitching (step 2) ===== -->
            <Grid x:Name="StitchingContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="13*" />
                </Grid.ColumnDefinitions>

                <!-- Live Preview (dynamic) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live Preview" FontSize="17" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="StitchPreviewCanvas" Width="340" Height="360" />
                        </Viewbox>

                        <!-- Summary -->
                        <Border Grid.Row="2" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="18" Height="14" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Paper Size (W x L)" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="SummaryPaperSize" Text="210 x 297 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Stitch Mode" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="SummaryStitchMode" Text="Saddle" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2195;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Spacing" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="SummarySpacing" Text="10.0 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2194;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Horizontal Offset" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="SummaryHOffset" Text="0.0 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2195;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Vertical Offset" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="SummaryVOffset" Text="0.0 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Stitching Parameters (form) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <!-- Only the parameter form scrolls when the window is too
                         short. The live preview and wizard footer remain fixed
                         and immediately accessible. Touch panning is enabled
                         for the production tablet. -->
                    <ScrollViewer x:Name="StitchingParametersScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" CanContentScroll="False">
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Stitching Parameters" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- Paper Width / Length -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paper Width (W)" Style="{StaticResource ParamLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PaperWidthBox" Style="{StaticResource NumberBoxStyle}"
                                             Text="210.0" TextChanged="OnParamChanged" IsReadOnly="True" Cursor="Hand"
                                             Tag="PaperWidth" PreviewMouseLeftButtonDown="OnStitchNumericFieldPressed" />
                                    <TextBlock Grid.Column="1" x:Name="PaperWidthUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Paper Length (L)" Style="{StaticResource ParamLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PaperLengthBox" Style="{StaticResource NumberBoxStyle}"
                                             Text="297.0" TextChanged="OnParamChanged" IsReadOnly="True" Cursor="Hand"
                                             Tag="PaperLength" PreviewMouseLeftButtonDown="OnStitchNumericFieldPressed" />
                                    <TextBlock Grid.Column="1" x:Name="PaperLengthUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Stitch Mode -->
                        <TextBlock Grid.Row="4" Text="Stitch Mode" Style="{StaticResource ParamLabelStyle}" Margin="0" />
                        <UniformGrid Grid.Row="6" Columns="5">
                            <Button x:Name="ModeSaddle" Style="{StaticResource StitchModeButtonStyle}" Tag="Saddle" Click="OnStitchModeClick">
                                <StackPanel>
                                    <Viewbox Width="46" Height="46">
                                        <Canvas Width="46" Height="46">
                                            <Rectangle Canvas.Left="9" Canvas.Top="12" Width="13" Height="24" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Left="24" Canvas.Top="12" Width="13" Height="24" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Line X1="23" Y1="10" X2="23" Y2="38" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.2" StrokeDashArray="2,2" />
                                            <Rectangle Canvas.Left="21.5" Canvas.Top="17" Width="3" Height="5" Fill="{StaticResource TextSecondaryBrush}" />
                                            <Rectangle Canvas.Left="21.5" Canvas.Top="27" Width="3" Height="5" Fill="{StaticResource TextSecondaryBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="ModeSaddleLabel" Text="Saddle" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeTop" Style="{StaticResource StitchModeButtonStyle}" Tag="Top" Click="OnStitchModeClick">
                                <StackPanel>
                                    <Viewbox Width="46" Height="46">
                                        <Canvas Width="46" Height="46">
                                            <Rectangle Canvas.Left="14" Canvas.Top="10" Width="18" Height="28" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Left="19" Canvas.Top="7" Width="8" Height="5" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Left="19" Canvas.Top="14" Width="3" Height="4" Fill="{StaticResource TextSecondaryBrush}" />
                                            <Rectangle Canvas.Left="24" Canvas.Top="14" Width="3" Height="4" Fill="{StaticResource TextSecondaryBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="ModeTopLabel" Text="Top" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeRightCorner" Style="{StaticResource StitchModeButtonStyle}" Tag="Right Corner" Click="OnStitchModeClick">
                                <StackPanel>
                                    <Viewbox Width="46" Height="46">
                                        <Canvas Width="46" Height="46">
                                            <Rectangle Canvas.Left="12" Canvas.Top="10" Width="18" Height="28" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Line X1="25" Y1="13" X2="30" Y2="18" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="ModeRightCornerLabel" Text="Right Corner" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeLeftCorner" Style="{StaticResource StitchModeButtonStyle}" Tag="Left Corner" Click="OnStitchModeClick">
                                <StackPanel>
                                    <Viewbox Width="46" Height="46">
                                        <Canvas Width="46" Height="46">
                                            <Rectangle Canvas.Left="16" Canvas.Top="10" Width="18" Height="28" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                            <Line X1="16" Y1="18" X2="21" Y2="13" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="ModeLeftCornerLabel" Text="Left Corner" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeNone" Style="{StaticResource StitchModeButtonStyle}" Tag="None" Click="OnStitchModeClick">
                                <StackPanel>
                                    <Viewbox Width="46" Height="46">
                                        <Canvas Width="46" Height="46">
                                            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="30" Height="30" Stroke="{StaticResource StatusErrorBrush}" StrokeThickness="3" />
                                            <Line X1="13" Y1="33" X2="33" Y2="13" Stroke="{StaticResource StatusErrorBrush}" StrokeThickness="3" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="ModeNoneLabel" Text="None" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Spacing -->
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spacing Between Stitches" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="SpacingBox" Style="{StaticResource NumberBoxStyle}"
                                         Text="10.0" TextChanged="OnParamChanged" IsReadOnly="True" Cursor="Hand"
                                         Tag="Spacing" PreviewMouseLeftButtonDown="OnStitchNumericFieldPressed" />
                                <TextBlock Grid.Column="1" x:Name="StitchSpacingUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                            </Grid>
                        </Grid>

                        <!-- Horizontal offset -->
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                <Run Text="Horizontal Offset Stitch " FontSize="17" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="(Left -/ Right +)" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="HOffsetBox" Style="{StaticResource NumberBoxStyle}"
                                         Text="0.0" TextChanged="OnParamChanged" IsReadOnly="True" Cursor="Hand"
                                         Tag="HorizontalOffset" PreviewMouseLeftButtonDown="OnStitchNumericFieldPressed" />
                                <TextBlock Grid.Column="1" x:Name="HorizontalOffsetUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                            </Grid>
                        </Grid>

                        <!-- Vertical offset -->
                        <Grid Grid.Row="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                <Run Text="Vertical Offset Stitch " FontSize="17" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="(Front - / Rear +)" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="VOffsetBox" Style="{StaticResource NumberBoxStyle}"
                                         Text="0.0" TextChanged="OnParamChanged" IsReadOnly="True" Cursor="Hand"
                                         Tag="VerticalOffset" PreviewMouseLeftButtonDown="OnStitchNumericFieldPressed" />
                                <TextBlock Grid.Column="1" x:Name="VerticalOffsetUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Folding (step 3) ===== -->
            <Grid x:Name="FoldingContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="13*" />
                </Grid.ColumnDefinitions>

                <!-- Live Preview (dynamic fold) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live Preview" FontSize="17" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="FoldPreviewCanvas" Width="340" Height="340" />
                        </Viewbox>

                        <Border Grid.Row="2" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="18" Height="14" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Folding" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="FoldSummaryFolding" Text="Enabled" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2194;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Fold Position" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="FoldSummaryPosition" Text="10.00 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="16" Height="16" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Pressure Mode" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="FoldSummaryPressure" Text="Manual" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Folding Settings (form) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Folding Settings" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- Fold Function -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fold Function:" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="FoldEnabledButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="Enabled" Tag="Enabled" Click="OnFoldFunctionClick" />
                            <Button Grid.Column="3" x:Name="FoldDisabledButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="Disabled" Tag="Disabled" Click="OnFoldFunctionClick" />
                        </Grid>

                        <Border Grid.Row="4" Background="{StaticResource CardBorderBrush}" Height="1" />

                        <!-- Fold Position -->
                        <TextBlock Grid.Row="6" Text="Fold Position" FontSize="17" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="FoldMinusButton" Style="{StaticResource StepperButtonStyle}" Content="&#8722;" Click="OnFoldMinusClick" />
                            <Border Width="180" Height="52" Margin="10,0" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource OutlineButtonBorderBrush}" Background="{StaticResource CardBackgroundBrush}"
                                    Cursor="Hand" PreviewMouseLeftButtonDown="OnFoldPositionInputPressed">
                                <TextBlock x:Name="FoldPositionValueText" Text="10.0" FontSize="22"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button x:Name="FoldPlusButton" Style="{StaticResource StepperButtonStyle}" Content="+" Click="OnFoldPlusClick" />
                            <TextBlock x:Name="FoldPositionUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                        </StackPanel>
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Backward (-)" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="FoldPositionSlider" Style="{StaticResource LineSliderStyle}" Margin="14,0"
                                    Minimum="-50" Maximum="50" Value="10" ValueChanged="OnFoldPositionChanged" />
                            <TextBlock Grid.Column="2" Text="Forward (+)" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="12" Text="Adjust fold forward (+) or backward (-) from center" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />

                        <Border Grid.Row="14" Background="{StaticResource CardBorderBrush}" Height="1" />

                        <!-- Pressure Mode -->
                        <Grid Grid.Row="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pressure Mode" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" x:Name="PressureAutoButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="120" Content="Auto" Tag="Auto" Click="OnPressureModeClick" />
                            <Button Grid.Column="4" x:Name="PressureDefaultButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="120" Content="Default" Tag="Default" Click="OnPressureModeClick" />
                            <Button Grid.Column="6" x:Name="PressureManualButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="120" Content="Manual" Tag="Manual" Click="OnPressureModeClick" />
                        </Grid>
                        <Grid Grid.Row="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Less pressure" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="PressureSlider" Style="{StaticResource LineSliderStyle}" Margin="14,0"
                                    Minimum="0" Maximum="1" Value="0.45" ValueChanged="OnPressureChanged" />
                            <TextBlock Grid.Column="2" Text="More pressure" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="20" Text="Auto mode will adjust pressure based on booklet thickness" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Trimming (step 4) ===== -->
            <Grid x:Name="TrimmingContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="13*" />
                </Grid.ColumnDefinitions>

                <!-- Live Preview (dynamic length) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live Preview" FontSize="17" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="TrimPreviewCanvas" Width="340" Height="340" />
                        </Viewbox>

                        <Border Grid.Row="2" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="18" Height="14" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Trimming" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="TrimSummaryTrimming" Text="Enabled" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2194;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Final Booklet Length" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="TrimSummaryLength" Text="205.0 mm" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2195;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Clamp Conveyor Height" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="TrimSummaryClamp" Text="Automatic" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="16" Height="16" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Chip Blower" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="TrimSummaryChip" Text="On" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Trimming Settings (form) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <ScrollViewer x:Name="TrimmingSettingsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" CanContentScroll="False">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Trimming Settings" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

                        <!-- Trim Function -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Trim Function:" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="TrimEnabledButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="Enabled" Tag="Enabled" Click="OnTrimFunctionClick" />
                            <Button Grid.Column="3" x:Name="TrimDisabledButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="Disabled" Tag="Disabled" Click="OnTrimFunctionClick" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,18" />

                        <!-- Final Booklet Length -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Final Booklet Length" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="FinalLengthMinus" Style="{StaticResource StepperButtonStyle}" Content="&#8722;" Click="OnFinalLengthMinus" />
                                <TextBox x:Name="FinalLengthBox" Style="{StaticResource NumberBoxStyle}" Width="150" Margin="10,0"
                                         Text="205.0" TextChanged="OnFinalLengthChanged" IsReadOnly="True" Cursor="Hand"
                                         PreviewMouseLeftButtonDown="OnFinalLengthInputPressed" />
                                <Button x:Name="FinalLengthPlus" Style="{StaticResource StepperButtonStyle}" Content="+" Click="OnFinalLengthPlus" />
                                <TextBlock x:Name="FinalLengthUnitText" Text="mm" Style="{StaticResource UnitLabelStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Enter the desired final length" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,18" />

                        <!-- Clamp Conveyor Height -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Clamp Conveyor Height" FontSize="17" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Trimmer height conveyor self adjusts in relation to booklet thickness"
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                            <UniformGrid Grid.Column="2" Columns="3" Width="330">
                                <Button x:Name="ClampAutoButton" Style="{StaticResource StitchModeButtonStyle}" Tag="Auto" Click="OnClampHeightClick">
                                    <StackPanel>
                                        <Viewbox Width="60" Height="46">
                                            <Canvas Width="60" Height="46">
                                                <Rectangle Canvas.Left="12" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Rectangle Canvas.Left="34" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Polygon Points="8,42 26,42 26,28" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" />
                                                <Polygon Points="34,42 52,42 52,28" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="ClampAutoLabel" Text="Auto" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClampMaximumButton" Style="{StaticResource StitchModeButtonStyle}" Tag="Maximum" Click="OnClampHeightClick">
                                    <StackPanel>
                                        <Viewbox Width="60" Height="46">
                                            <Canvas Width="60" Height="46">
                                                <Rectangle Canvas.Left="12" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Rectangle Canvas.Left="34" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Polygon Points="8,42 52,42 52,22" Fill="{StaticResource TextSecondaryBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="ClampMaximumLabel" Text="Maximum" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClampMinimumButton" Style="{StaticResource StitchModeButtonStyle}" Tag="Minimum" Click="OnClampHeightClick">
                                    <StackPanel>
                                        <Viewbox Width="60" Height="46">
                                            <Canvas Width="60" Height="46">
                                                <Rectangle Canvas.Left="12" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Rectangle Canvas.Left="34" Canvas.Top="4" Width="14" Height="14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" />
                                                <Polygon Points="8,42 52,42 52,36" Fill="{StaticResource CardBorderBrush}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="ClampMinimumLabel" Text="Minimum" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,18" />

                        <!-- Chip Blower -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chip Blower" FontSize="17" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="ChipOnButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="On" Tag="On" Click="OnChipBlowerClick" />
                            <Button Grid.Column="3" x:Name="ChipOffButton" Style="{StaticResource ChoiceButtonStyle}" MinWidth="150" Content="Off" Tag="Off" Click="OnChipBlowerClick" />
                        </Grid>
                        <TextBlock Text="Evacuates trim chips" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Conveyor (step 5) ===== -->
            <Grid x:Name="ConveyorContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="13*" />
                </Grid.ColumnDefinitions>

                <!-- Live Preview (dynamic spacing / offset) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live Preview" FontSize="17" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1" Text="Booklet Spacing" FontSize="15" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="SpacingPreviewCanvas" Width="300" Height="110" />
                        </Viewbox>

                        <TextBlock Grid.Row="3" Text="Booklet Offset" FontSize="15" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Viewbox Grid.Row="4" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="OffsetPreviewCanvas" Width="300" Height="110" />
                        </Viewbox>

                        <Border Grid.Row="5" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2194;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Booklet Spacing" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="ConvSummarySpacing" Text="8" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x21C4;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Booklet Offset" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="ConvSummaryOffset" Text="10" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Width="18" TextAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Conveyor Full Detection" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="ConvSummaryDetection" Text="Enabled" FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Conveyor Settings (form) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <ScrollViewer x:Name="ConveyorSettingsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" CanContentScroll="False">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Conveyor Settings" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Booklet Spacing -->
                        <TextBlock Text="Booklet Spacing" FontSize="17" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Adjust the output conveyor advance (1 to 30) to set the space between booklets"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="76" Height="52" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource OutlineButtonBorderBrush}" Background="{StaticResource CardBackgroundBrush}"
                                    Cursor="Hand" Tag="Spacing" PreviewMouseLeftButtonDown="OnConveyorNumericInputPressed">
                                <TextBlock x:Name="SpacingValueText" Text="8" FontSize="22" Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="2" x:Name="SpacingMinus" Style="{StaticResource StepperButtonStyle}" Content="&#8722;" Click="OnSpacingMinus" />
                            <Slider Grid.Column="4" x:Name="SpacingSlider" Style="{StaticResource LineSliderStyle}"
                                    Minimum="1" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSpacingSliderChanged" />
                            <Button Grid.Column="6" x:Name="SpacingPlus" Style="{StaticResource StepperButtonStyle}" Content="+" Click="OnSpacingPlus" />
                        </Grid>
                        <TextBlock Text="1 = small space, 29 = long space, 30 = continuous advance"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,18" />

                        <!-- Booklet Offset -->
                        <TextBlock Text="Booklet Offset" FontSize="17" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Offset every X booklet to make counting easier"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="76" Height="52" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource OutlineButtonBorderBrush}" Background="{StaticResource CardBackgroundBrush}"
                                    Cursor="Hand" Tag="Offset" PreviewMouseLeftButtonDown="OnConveyorNumericInputPressed">
                                <TextBlock x:Name="OffsetValueText" Text="10" FontSize="22" Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="2" x:Name="OffsetMinus" Style="{StaticResource StepperButtonStyle}" Content="&#8722;" Click="OnOffsetMinus" />
                            <Slider Grid.Column="4" x:Name="OffsetSlider" Style="{StaticResource LineSliderStyle}"
                                    Minimum="1" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnOffsetSliderChanged" />
                            <Button Grid.Column="6" x:Name="OffsetPlus" Style="{StaticResource StepperButtonStyle}" Content="+" Click="OnOffsetPlus" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,18" />

                        <!-- Conveyor Full Detection -->
                        <TextBlock Text="Conveyor Full Detection" FontSize="17" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose whether to stop when the machine conveyor is full"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="FullDetectionEnabledButton" Style="{StaticResource ChoiceButtonStyle}" Content="Enabled" Tag="Enabled" Click="OnFullDetectionClick" />
                            <Button Grid.Column="2" x:Name="FullDetectionDisabledButton" Style="{StaticResource ChoiceButtonStyle}" Content="Disabled" Tag="Disabled" Click="OnFullDetectionClick" />
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Footer actions ================= -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource FooterButtonStyle}" Click="OnBackClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="BackButtonText" Text="Back" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource FooterButtonStyle}" Click="OnResetClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Reset" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="3" x:Name="FooterStatusText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource StatusRunningBrush}" />

            <Button Grid.Column="4" Style="{StaticResource PrimaryFooterButtonStyle}" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Save" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6" x:Name="NextButton" Style="{StaticResource FooterButtonStyle}" Click="OnNextClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NextButtonText" Text="Next: Stitching" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <local:DecimalInputDialog x:Name="StitchNumericDialog" Grid.Row="0" Grid.RowSpan="7"
                                  Panel.ZIndex="50" />
        <local:NumericInputDialog x:Name="ConveyorNumericDialog" Grid.Row="0" Grid.RowSpan="7"
                                  Panel.ZIndex="51" />
    </Grid>
</UserControl>
