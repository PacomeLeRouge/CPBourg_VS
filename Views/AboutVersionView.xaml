<UserControl x:Class="CPBourg.NextGenGui.Views.AboutVersionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ScreenBackgroundBrush}">
    <Grid Margin="24,20">
        <Border Style="{StaticResource CardStyle}" Padding="36"
                Width="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="AboutMessageText"
                       Text="This is a mockup prototype made by OpenHub for C.P. Bourg for the summer of 2026."
                       FontSize="22" FontWeight="Medium" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
