<UserControl x:Class="CPBourg.NextGenGui.Views.TechnicianInterfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CPBourg.NextGenGui.Views">
    <UserControl.Resources>
        <Style x:Key="TechnicianCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <Style x:Key="TechnicianOptionStyle" TargetType="RadioButton"
               BasedOn="{StaticResource OptionRadioButtonStyle}">
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <EventSetter Event="Checked" Handler="OnSettingChanged" />
        </Style>

        <Style x:Key="TechnicianCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <EventSetter Event="Checked" Handler="OnSettingChanged" />
            <EventSetter Event="Unchecked" Handler="OnSettingChanged" />
        </Style>

        <Style x:Key="ActionTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <!--
            The 1280 x 748 design surface is the shell's original 1280 x 820
            window minus its 72 px header. A Viewbox scales that complete
            surface uniformly to the real client area (which is slightly
            shorter once Windows adds its title bar), so the footer remains
            visible in windowed mode and the layout grows proportionally in
            fullscreen. Uniform scaling preserves card and icon proportions;
            unlike the previous ScrollViewer, it never requires vertical
            scrolling to reach an action.
        -->
        <Viewbox Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="1244" Height="712" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="424" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <!-- Machine and access status -->
                <Border Grid.Row="0" Style="{StaticResource TechnicianCardStyle}" Padding="24,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="13" Height="13" Fill="{StaticResource StatusRunningBrush}" Margin="0,0,14,0" />
                            <TextBlock Text="Status:" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Technician Mode" FontSize="15" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource CardBorderBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Ellipse Width="13" Height="13" Fill="{StaticResource StatusRunningBrush}" Margin="0,0,14,0" />
                            <TextBlock Text="Machine:" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Ready" FontSize="15" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource CardBorderBrush}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Access:" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccessStatusText" Text="Protected" FontSize="15" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Seven settings and current speed -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="130" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="1.  Calibration Set Option" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <RadioButton x:Name="CalibrationAlwaysProcessRadio" GroupName="CalibrationOption"
                                             Content="Always Process" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="CalibrationAlwaysRejectRadio" GroupName="CalibrationOption"
                                             Content="Always Reject" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="3.  Stitch Head Form" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <RadioButton x:Name="NormalStitchRadio" GroupName="StitchForm"
                                             Content="Normal Stitch" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="LoopStitchRadio" GroupName="StitchForm"
                                             Content="Loop Stitch" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="6.  Purge Option" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <RadioButton x:Name="PurgeAskOperatorRadio" GroupName="PurgeOption"
                                             Content="Ask Operator" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="PurgeAlwaysProcessRadio" GroupName="PurgeOption"
                                             Content="Always Process" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="PurgeAlwaysPurgeRadio" GroupName="PurgeOption"
                                             Content="Always Purge" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="2.  Save Adjustments" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <RadioButton x:Name="SaveAdjustmentsDisabledRadio" GroupName="SaveAdjustments"
                                             Content="Disabled" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="SaveAdjustmentsEnabledRadio" GroupName="SaveAdjustments"
                                             Content="Enabled" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="4.  Stitch Detection Control" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="2,7,0,0">
                                <CheckBox x:Name="DisableHead1CheckBox" Content="Disable Head 1"
                                          Style="{StaticResource TechnicianCheckBoxStyle}" />
                                <CheckBox x:Name="DisableHead2CheckBox" Content="Disable Head 2"
                                          Style="{StaticResource TechnicianCheckBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="7.  Sheet in Compiler Restart" FontSize="17"
                                           FontWeight="SemiBold" Margin="0,0,34,0" />
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <RadioButton x:Name="RestartAllowedRadio" GroupName="CompilerRestart"
                                             Content="Allowed" Style="{StaticResource TechnicianOptionStyle}" />
                                <RadioButton x:Name="RestartForbiddenRadio" GroupName="CompilerRestart"
                                             Content="Forbidden" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="5.  Stitch Single Sheet" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                                           HorizontalAlignment="Right" Foreground="{StaticResource HeaderBackgroundBrush}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                <RadioButton x:Name="SingleSheetDisabledRadio" GroupName="SingleSheet"
                                             Content="Disabled" Style="{StaticResource TechnicianOptionStyle}" Margin="0,0,28,0" />
                                <RadioButton x:Name="SingleSheetEnabledRadio" GroupName="SingleSheet"
                                             Content="Enabled" Style="{StaticResource TechnicianOptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource TechnicianCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current Speed" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentSpeedValueText" Text="1291" FontSize="42" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrentSpeedUnitText" Text="mm/s" FontSize="15" Margin="10,0,0,6" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="36" Foreground="{StaticResource HeaderBackgroundBrush}"
                                       VerticalAlignment="Center" Margin="15,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Technician actions -->
                <Border Grid.Row="4" Style="{StaticResource TechnicianCardStyle}" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Technician Actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionTileStyle}" Tag="Reset BBM" Click="OnActionClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                                               Foreground="{StaticResource HeaderBackgroundBrush}" Width="48" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Reset BBM" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Return machine to home position" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="175" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ActionTileStyle}" Tag="Stitch Pulse" Click="OnActionClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE95E;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                                               Foreground="{StaticResource HeaderBackgroundBrush}" Width="48" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Stitch Pulse" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Run 1 stitch head cycle" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="175" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource ActionTileStyle}" Tag="Shipping Position" Click="OnActionClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                                               Foreground="{StaticResource HeaderBackgroundBrush}" Width="48" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Shipping Position" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Prepare machine for transport" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="175" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Style="{StaticResource ActionTileStyle}" Click="OnTechnicalAccessClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                                               Foreground="{StaticResource HeaderBackgroundBrush}" Width="48" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Technical Access" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Password protected — skilled personnel only" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="175" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Navigation and persistence -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource FooterButtonStyle}" Click="OnBackClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" />
                            <TextBlock Text="Back" Margin="12,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource FooterButtonStyle}" Click="OnResetClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" />
                            <TextBlock Text="Reset" Margin="12,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="FooterStatusText" Grid.Column="3" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="15,0" />
                    <Button Grid.Column="4" Style="{StaticResource FooterButtonStyle}" Click="OnSaveClick"
                            Background="{StaticResource HeaderBackgroundBrush}" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" />
                            <TextBlock Text="Save" Margin="12,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource FooterButtonStyle}" Click="OnConfirmClick"
                            Background="{StaticResource HeaderBackgroundBrush}" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" />
                            <TextBlock Text="Confirm" Margin="12,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Viewbox>

        <local:TechnicalAccessDialog x:Name="AccessDialog" />
    </Grid>
</UserControl>
