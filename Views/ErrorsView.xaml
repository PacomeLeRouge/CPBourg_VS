<UserControl x:Class="CPBourg.NextGenGui.Views.ErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CPBourg.NextGenGui.Models"
             xmlns:local="clr-namespace:CPBourg.NextGenGui.Views"
             Background="{StaticResource ScreenBackgroundBrush}">

    <!--
        Errors & Information screen (FR-06 error/warning management; AC-05).
        Four summary tiles (Critical/Warning/Info/Resolved counts), an Active
        Messages list, an empty state when there's nothing to show, and a
        detail overlay (ErrorDetailDialog) opened by clicking a row.

        ICON NOTE: the header bell icon (added to MainWindow's shared header
        for this screen, see MainWindow.xaml) uses an unverified codepoint.
        Everything else here reuses icons already confirmed elsewhere in
        this app (warning triangle, info circle, checkmark, chevron-right,
        trash, close X, folder - the last one doubles as the empty-state
        illustration rather than risking a new "empty inbox" glyph guess).

        Sample data (5 messages) is populated in ErrorsView.xaml.cs. Nothing
        here is connected to the WFM yet - replace with real WFM-reported
        errors/warnings once that connection exists (FR-01, FR-02).
    -->

    <UserControl.Resources>
        <local:ErrorSeverityToBrushConverter x:Key="SeverityToBrush" Background="False" />
        <local:ErrorSeverityToBrushConverter x:Key="SeverityToBgBrush" Background="True" />

        <DataTemplate x:Key="ErrorRowTemplate" DataType="{x:Type models:ErrorRecord}">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SeverityLabel}" FontSize="14" Margin="8,0,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ModuleOrJob}" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Details}" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <TextBlock Grid.Column="5" Text="&#xE76C;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ErrorListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBg" Background="Transparent"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="4,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource ScreenBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary tiles -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                   Foreground="{StaticResource StatusErrorBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Critical" FontSize="15" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CriticalCountText" Text="0" FontSize="28" FontWeight="Medium"
                               Foreground="{StaticResource StatusErrorBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Warning" FontSize="15" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WarningCountText" Text="0" FontSize="28" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                   Foreground="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Info" FontSize="15" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="InfoCountText" Text="0" FontSize="28" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                   Foreground="{StaticResource StatusRunningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Resolved" FontSize="15" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ResolvedCountText" Text="0" FontSize="28" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Active Messages -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Active Messages" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="6"
                                Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveCountBadgeText" Text="0" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Populated (non-empty) state -->
                <Grid x:Name="MessagesPopulatedPanel" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Severity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="Module/Job" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="3" Text="Time" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="4" Text="Details" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                    <Border Grid.Row="0" Background="{StaticResource CardBorderBrush}" Height="1" VerticalAlignment="Bottom" />

                    <ListBox Grid.Row="1" x:Name="MessagesListBox"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource ErrorRowTemplate}"
                             ItemContainerStyle="{StaticResource ErrorListItemStyle}"
                             SelectionChanged="OnMessageSelectionChanged" />
                </Grid>

                <!-- Empty state -->
                <StackPanel x:Name="MessagesEmptyPanel" Grid.Row="2" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="12"
                            Background="{StaticResource ScreenBackgroundBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFontFamily}" FontSize="26"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No active messages" FontSize="16" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="All clear! No messages at this time." FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Home and Clear actions sit outside the white Active Messages
             card on the page background. -->
        <Button x:Name="HomeButton" Grid.Row="4" HorizontalAlignment="Left"
                MinHeight="48" MinWidth="140" Padding="16,10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource OutlineButtonBorderBrush}" BorderThickness="1"
                Cursor="Hand" Click="OnHomeClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Home" FontSize="15" Margin="9,0,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Row="4" HorizontalAlignment="Right" MinHeight="48" MinWidth="120"
                Background="{StaticResource JobsAccentBrush}"
                Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                Click="OnClearAllClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                           Foreground="{StaticResource JobsAccentForegroundBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Clear" FontSize="15" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Detail overlay -->
        <local:ErrorDetailDialog x:Name="ErrorDetailDialogControl" Grid.Row="0" Grid.RowSpan="5" Cleared="OnDetailCleared" />
    </Grid>
</UserControl>
