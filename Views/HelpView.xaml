<UserControl x:Class="CPBourg.NextGenGui.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ScreenBackgroundBrush}">
    <Grid Margin="24,20">
        <Border Style="{StaticResource CardStyle}" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="620">
            <TextBlock FontSize="20" TextAlignment="Center">
                <Hyperlink x:Name="ManualsHyperlink" NavigateUri="https://www.cpbourg.com/be/en/my-cpbourg"
                           RequestNavigate="OnManualsRequestNavigate"
                           Foreground="{StaticResource JobsAccentBrush}">
                    https://www.cpbourg.com/be/en/my-cpbourg
                </Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
