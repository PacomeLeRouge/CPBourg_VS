<UserControl x:Class="CPBourg.NextGenGui.Views.DateTimeSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid>
        <Border Background="{StaticResource OverlayScrimBrush}" MouseDown="OnScrimMouseDown" />

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16"
                Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource StatusIdleBgBrush}">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                                   Foreground="{StaticResource JobsAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Change Date and Time" FontSize="22" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent"
                            BorderThickness="0" Click="OnCancelClick">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Text="This changes the date and time displayed by the operator interface."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,20" />

                <TextBlock Text="Date" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <DatePicker x:Name="DatePickerControl" Height="50" FontSize="17"
                            VerticalContentAlignment="Center" />

                <TextBlock Text="Time (24-hour)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,18,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="HourComboBox" Grid.Column="0" Height="50" FontSize="17"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text=":" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ComboBox x:Name="MinuteComboBox" Grid.Column="2" Height="50" FontSize="17"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock x:Name="ValidationText" Text="Choose a valid date and time." FontSize="13"
                           Foreground="{StaticResource StatusErrorBrush}" Visibility="Collapsed"
                           Margin="0,8,0,0" />

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" MinHeight="52" Click="OnCancelClick">
                        <TextBlock Text="Cancel" FontSize="15" FontWeight="Medium" />
                    </Button>
                    <Button Grid.Column="2" MinHeight="52" Background="{StaticResource JobsAccentBrush}"
                            Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                            Click="OnSaveClick">
                        <TextBlock Text="OK" FontSize="15" FontWeight="Medium" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
