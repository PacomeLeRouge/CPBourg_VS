<Window x:Class="CPBourg.NextGenGui.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource ScreenBackgroundBrush}"
        FontFamily="{StaticResource BrandFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        DESIGN CANVAS: everything below is authored at a fixed 1024x768 (4:3)
        design resolution inside a Viewbox. The Viewbox scales the whole
        splash - logo, text, progress bar - as a single unit to fill whatever
        screen it actually runs on, so the design stays proportionally
        correct instead of appearing small on a larger display.

        Stretch="Uniform" preserves the 4:3 aspect ratio and letterboxes
        (with the ScreenBackgroundBrush colour) if the real screen isn't
        exactly 4:3. Once the actual industrial PC resolution is confirmed
        with CPBourg, this can be swapped for Stretch="Fill" if the target
        display's aspect ratio is known to match, or the 1024x768 canvas
        size below can simply be changed to match it.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1024" Height="768" Background="{StaticResource ScreenBackgroundBrush}">

            <!-- Logo lockup + subtitle -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="720" Margin="0,-100,0,0">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Two-square logo mark (placeholder). LogoImage is used
                         automatically if a real logo file is present at
                         Assets/cpbourg-logo.png - see LogoLoader.cs / README. -->
                    <Grid Width="72" Height="72" VerticalAlignment="Center">
                        <Grid x:Name="LogoPlaceholder">
                            <Border Width="44" Height="44"
                                    Background="{StaticResource BrandSecondaryMarkBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Border Width="44" Height="44"
                                    Background="{StaticResource BrandAccentBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Image x:Name="LogoImage" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="C.P. Bourg"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="36" FontWeight="Medium" />
                        <TextBlock Text="NextGen Operator Interface"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="Medium" Margin="0,3,0,0" />
                        <TextBlock Text="Your Partner in Print Finishing."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="15" Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Status + progress bar -->
                <StackPanel Margin="0,80,0,0">
                    <TextBlock x:Name="StatusText" Text="Initializing system"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,14" />

                    <Border Height="8" CornerRadius="4"
                            Background="{StaticResource ProgressTrackBrush}"
                            HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressFill" Height="8" CornerRadius="4"
                                Background="{StaticResource ProgressFillBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <TextBlock x:Name="VersionText" Text="Version: 1.30.0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="28,0,0,20" />
            <TextBlock x:Name="BuildText" Text="Build: 2026-07"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,28,20" />
        </Grid>
    </Viewbox>
</Window>
