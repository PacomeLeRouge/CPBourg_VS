<UserControl x:Class="CPBourg.NextGenGui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CPBourg.NextGenGui.Models"
             xmlns:views="clr-namespace:CPBourg.NextGenGui.Views"
             Background="{StaticResource ScreenBackgroundBrush}">

	<UserControl.Resources>
		<!-- Converters map the UI-agnostic MachineStatus enum (Models layer)
             to brush resources (Views/Theme layer) - keeps Models free of
             any WPF dependency. -->
		<views:MachineStatusToBrushConverter x:Key="StatusToBrush" Background="False" />
		<views:MachineStatusToBrushConverter x:Key="StatusToBgBrush" Background="True" />

		<Style x:Key="CounterStepButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="44" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontSize" Value="22" />
		</Style>

		<Style x:Key="CounterValueButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="140" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="Margin" Value="6,0" />
			<Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource OutlineButtonBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<!-- One machine tile. Keeps the enlarged status icon, but uses a
             more compact size so tiles do not clip in windowed mode. -->
		<DataTemplate DataType="{x:Type models:MachineTileInfo}">
			<Border Background="{Binding Status, Converter={StaticResource StatusToBgBrush}}"
                    CornerRadius="10" Margin="4" Padding="12" MinHeight="78"
                    Cursor="Hand" MouseLeftButtonUp="OnMachineTileClick">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}"
                            BorderThickness="1.5" VerticalAlignment="Center">
						<TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="22"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>

					<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
						<TextBlock Text="{Binding ShortCode}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
						<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
							<Ellipse Width="8" Height="8"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                     VerticalAlignment="Center" />
							<TextBlock Text="{Binding StatusLabel}" FontSize="13" Margin="6,0,0,0"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                       VerticalAlignment="Center" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<!--
        Home dashboard content, below the app-shell header (see MainWindow).

        Fully fluid layout - no fixed design canvas. Columns use star sizing
        so the dashboard genuinely fills whatever screen it runs on (this
        used to sit inside a fixed 1024x768 canvas wrapped in a Viewbox,
        which left empty margins on any non-4:3 screen; removed - see
        MainWindow.xaml for the full explanation).

        Sized for tablet/touch use throughout (44px+ interactive targets),
        since the production interface runs on a tablet mounted on the
        machine, not a desktop monitor.

        Sample data (machine tiles, current job) is populated in the
        code-behind for this prototype. Replace with real WFM-backed data
        once the connection is wired in (FR-01, FR-02).
    -->

	<Grid>
	<Grid Margin="24,20,24,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="16" />
			<RowDefinition Height="100" />
			<RowDefinition Height="14" />
		</Grid.RowDefinitions>

		<!-- ================= Main two-column area ================= -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<!-- Left column: Counter and Productivity + Machines -->
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="2*" />
					<RowDefinition Height="14" />
					<RowDefinition Height="1*" />
				</Grid.RowDefinitions>

				<!-- Counter and Productivity card -->
				<Border Grid.Row="0" Style="{StaticResource CardStyle}">
					<Grid>
						<!-- The spacer rows below the completed-sets block use star
                             heights with a MinHeight floor: at the compact
                             windowed / 1024x768 size they collapse to the same
                             fixed gaps as before, but any extra height (full
                             screen) is absorbed here so the content spreads to
                             fill the card and the footer stat strip sits at the
                             bottom - instead of leaving empty white space below
                             it. The header-to-number gap (row 1) stays fixed so
                             those two always read as one group. -->
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="18" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" MinHeight="16" />
							<RowDefinition Height="1" />
							<RowDefinition Height="*" MinHeight="16" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" MinHeight="18" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Header -->
						<StackPanel Grid.Row="0" Orientation="Horizontal">
							<TextBlock Text="Counter and Productivity"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="18" FontWeight="Medium" />
							<TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFontFamily}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="18" Margin="8,2,0,0" VerticalAlignment="Center" />
						</StackPanel>

						<!-- Both counters use the same touch-friendly pattern: +/-
						     changes by one, while tapping the value opens the numeric
						     keypad for direct entry. -->
						<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
							<StackPanel>
								<TextBlock Text="Completed Sets" Foreground="{StaticResource TextMutedBrush}"
								           FontSize="12" Margin="0,0,0,5" />
								<StackPanel Orientation="Horizontal">
									<Button Style="{StaticResource CounterStepButtonStyle}" Click="OnCompletedDecrementClick"
									        ToolTip="Decrease completed sets by 1">
										<TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFontFamily}" FontSize="22" />
									</Button>
									<Button Style="{StaticResource CounterValueButtonStyle}" Click="OnCompletedInputClick"
									        ToolTip="Enter completed sets">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
											<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="105" MaxHeight="32">
												<TextBlock x:Name="CompletedSetsText" Text="0" FontSize="28" FontWeight="Medium"
												           Foreground="{StaticResource TextPrimaryBrush}" />
											</Viewbox>
											<TextBlock Grid.Column="1" Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}"
											           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0"
											           VerticalAlignment="Center" />
										</Grid>
									</Button>
									<Button Style="{StaticResource CounterStepButtonStyle}" Click="OnCompletedIncrementClick"
									        ToolTip="Increase completed sets by 1">
										<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="22" />
									</Button>
								</StackPanel>
							</StackPanel>

							<TextBlock Text="/" FontSize="30" FontWeight="Light"
							           Foreground="{StaticResource TextMutedBrush}"
							           Margin="16,23,0,0" VerticalAlignment="Center" />

							<StackPanel Margin="16,0,0,0">
								<TextBlock Text="Preset (0 = unlimited)" Foreground="{StaticResource TextMutedBrush}"
								           FontSize="12" Margin="0,0,0,5" />
								<StackPanel Orientation="Horizontal">
									<Button Style="{StaticResource CounterStepButtonStyle}" Click="OnCounterDecrementClick"
									        ToolTip="Decrease preset by 1">
										<TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFontFamily}" FontSize="22" />
									</Button>
									<Button Style="{StaticResource CounterValueButtonStyle}" Click="OnPresetInputClick"
									        ToolTip="Enter preset sets">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
											<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="105" MaxHeight="32">
												<TextBlock x:Name="PresetValueText" Text="&#8734;" FontSize="28" FontWeight="Medium"
												           Foreground="{StaticResource TextPrimaryBrush}" />
											</Viewbox>
											<TextBlock Grid.Column="1" Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}"
											           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0"
											           VerticalAlignment="Center" />
										</Grid>
									</Button>
									<Button Style="{StaticResource CounterStepButtonStyle}" Click="OnCounterIncrementClick"
									        ToolTip="Increase preset by 1">
										<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="22" />
									</Button>
								</StackPanel>
							</StackPanel>

							<Button x:Name="ConfirmCounterChangesButton" Padding="16,10" Height="52"
							        Margin="14,22,0,0" Click="OnConfirmCounterChangesClick" IsEnabled="False"
							        Background="{StaticResource JobsAccentBrush}"
							        Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" VerticalAlignment="Center" />
									<TextBlock Text="Confirm" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</StackPanel>

						<!-- Divider -->
						<Border Grid.Row="4" Background="{StaticResource CardBorderBrush}" Height="1" />

						<!-- Output/h + counter actions -->
						<Grid Grid.Row="6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="Output / h" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
								<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
									<TextBlock Text="1,248" Foreground="{StaticResource TextPrimaryBrush}" FontSize="21" FontWeight="Medium" />
									<TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource StatusRunningBrush}" FontSize="22"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
								<Button Padding="14,13" Height="52" Click="OnResetToZeroClick">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="19" VerticalAlignment="Center" />
										<TextBlock Text="Reset to zero" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button Padding="14,13" Height="52" Margin="8,0,0,0" Click="OnSetTargetClick">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}" FontSize="19" VerticalAlignment="Center" />
										<TextBlock Text="Set target" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>

						<!-- Mini stat strip - one box, vertical dividers between items -->
						<Border Grid.Row="8" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="1" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="1" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,12" HorizontalAlignment="Center">
									<TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="24" VerticalAlignment="Center" />
									<StackPanel Margin="8,0,0,0">
										<TextBlock Text="Completed sets" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
										<TextBlock x:Name="MiniCompletedSetsText" Text="5,234" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
									</StackPanel>
								</StackPanel>

								<Border Grid.Column="1" Background="{StaticResource CardBorderBrush}" Width="1" Margin="0,10" />

								<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,12" HorizontalAlignment="Center">
									<TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="24" VerticalAlignment="Center" />
									<StackPanel Margin="8,0,0,0">
										<TextBlock Text="Preset" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
										<TextBlock x:Name="MiniPresetText" Text="&#8734;" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
									</StackPanel>
								</StackPanel>

								<Border Grid.Column="3" Background="{StaticResource CardBorderBrush}" Width="1" Margin="0,10" />

								<StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,12" HorizontalAlignment="Center">
									<TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="24" VerticalAlignment="Center" />
									<StackPanel Margin="8,0,0,0">
										<TextBlock Text="Output / h" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
										<TextBlock Text="1,248" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
									</StackPanel>
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</Border>

				<!-- Machines card.
                     The tile row lives inside a Viewbox (Uniform, DownOnly) so
                     it scales DOWN to fit whenever this card is short - e.g. in
                     windowed mode and on the 1024x768 tablet, where a fixed
                     tile height previously got clipped ("3/4 cut off"). When
                     there is room (full screen / taller windows) the tiles stay
                     at their natural size, centred in the card instead of
                     clumping against the title. -->
				<Border Grid.Row="2" Style="{StaticResource CardStyle}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Text="Machines" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18" FontWeight="Medium" Margin="0,0,0,14" />
						<Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Top">
							<ItemsControl x:Name="MachineTilesControl" Width="600">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="4" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>
						</Viewbox>
					</Grid>
				</Border>
			</Grid>

			<!-- Right column: Current Jobs + Active Alerts -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="14" />
					<RowDefinition Height="1*" />
				</Grid.RowDefinitions>

				<!-- Current Jobs card.
                     Grid rows (title / job summary / buttons) instead of a
                     StackPanel so the job-summary box takes the leftover height
                     and the action buttons stay pinned to the bottom. Full
                     screen used to leave a large empty gap under the buttons;
                     now the summary box grows to absorb it. -->
				<Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Text="Current Jobs" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17" FontWeight="Medium" Margin="0,0,0,12" />

						<Border Grid.Row="1" Background="{StaticResource ScreenBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Border Grid.Column="0" Width="50" Height="50" CornerRadius="12"
                                        Background="{StaticResource StatusIdleBgBrush}" VerticalAlignment="Top">
									<TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource StatusIdleBrush}" FontSize="28"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<StackPanel Grid.Column="1" Margin="12,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock x:Name="JobNameText" Text="Sample Job A"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
										<Border x:Name="JobStatusPill" Background="{StaticResource StatusRunningBgBrush}" CornerRadius="9" Padding="8,3" Margin="8,0,0,0">
											<TextBlock x:Name="JobStatusText" Text="Running"
                                                       Foreground="{StaticResource StatusRunningBrush}" FontSize="11" FontWeight="Medium" />
										</Border>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
										<TextBlock Text="Quantity" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
										<TextBlock x:Name="JobQuantityText" Text="12,500" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,0,14,0" />
										<TextBlock Text="Completed" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
										<TextBlock x:Name="JobCompletedText" Text="5,234" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,0" />
									</StackPanel>
								</StackPanel>
								<TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFontFamily}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="24" VerticalAlignment="Center" />
							</Grid>
						</Border>

						<Grid Grid.Row="2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="10" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Padding="0,12" Height="56" Background="{StaticResource JobsAccentBrush}"
                                    Foreground="{StaticResource JobsAccentForegroundBrush}" BorderThickness="0"
                                    Click="OnNewJobClick">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
									<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" VerticalAlignment="Center" />
									<TextBlock Text="New job" FontSize="16" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button Grid.Column="2" Padding="0,12" Height="56" Click="OnLoadJobClick">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
									<TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" VerticalAlignment="Center" />
									<TextBlock Text="Load job" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</Grid>
					</Grid>
				</Border>

				<!-- Active Alerts card.
                     Title stays at the top; the alert block is centred in the
                     remaining space (Grid rows instead of a top-aligned
                     StackPanel) so full screen no longer leaves a large empty
                     gap beneath the button. -->
				<Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Text="Active Alerts" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17" FontWeight="Medium" Margin="0,0,0,14" />
						<Grid Grid.Row="1" VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border Grid.Column="0" x:Name="AlertsIconBg" Width="52" Height="52" CornerRadius="26"
                                    Background="{StaticResource StatusRunningBgBrush}" VerticalAlignment="Top">
								<TextBlock x:Name="AlertsIconText" Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}"
                                           Foreground="{StaticResource StatusRunningBrush}" FontSize="26"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<StackPanel Grid.Column="1" Margin="12,0,0,0">
								<TextBlock x:Name="AlertsHeadlineText" Text="No active alerts"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
								<TextBlock x:Name="AlertsSubtitleText" Text="All systems are operating normally."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
								<Button Padding="16,13" Height="52" HorizontalAlignment="Left" Click="OnViewErrorsClick">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" VerticalAlignment="Center" />
										<TextBlock Text="View errors" FontSize="15" Margin="7,0,0,0" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>

		<!-- ================= Action bar =================
             Start/Pause/Stop icons are wrapped in a coloured circle to
             match the reference mock more closely. -->
		<UniformGrid Grid.Row="2" Columns="4" Rows="1">
			<Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,6,0">
				<Button Background="Transparent" BorderThickness="0" Click="OnPurgeClick">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
						<StackPanel Margin="12,0,0,0">
							<TextBlock Text="Purge" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
							<TextBlock Text="Clear after jam" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
						</StackPanel>
					</StackPanel>
				</Button>
			</Border>
			<Border Style="{StaticResource CardStyle}" Padding="0" Margin="6,0">
				<Button Background="Transparent" BorderThickness="0" Click="OnStartClick">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Border Width="46" Height="46" CornerRadius="23" BorderThickness="2"
                                BorderBrush="{StaticResource StatusRunningBrush}">
							<TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                       Foreground="{StaticResource StatusRunningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<TextBlock Text="Start" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Border>
			<Border Style="{StaticResource CardStyle}" Padding="0" Margin="6,0">
				<Button Background="Transparent" BorderThickness="0" Click="OnPauseClick">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Border Width="46" Height="46" CornerRadius="23" BorderThickness="2"
                                BorderBrush="{StaticResource BrandAccentBrush}">
							<TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFontFamily}" FontSize="22"
                                       Foreground="{StaticResource BrandAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<TextBlock Text="Pause" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Border>
			<Border Style="{StaticResource CardStyle}" Padding="0" Margin="6,0,0,0">
				<Button Background="Transparent" BorderThickness="0" Click="OnStopClick">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Border Width="46" Height="46" CornerRadius="23" BorderThickness="2"
                                BorderBrush="{StaticResource StatusErrorBrush}">
							<Rectangle Width="16" Height="16" Fill="{StaticResource StatusErrorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<TextBlock Text="Stop" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Border>
		</UniformGrid>

		<!-- Status line - confirms the last control action (Start / Pause /
             Stop / Purge / preset / target). These act on local mockup state;
             swap for WFM-backed commands once that link exists (FR-03). -->
		<TextBlock Grid.Row="3" x:Name="LastActionText" Text=""
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                   HorizontalAlignment="Center" />
	</Grid>
	<views:NumericInputDialog x:Name="CounterInputDialog" />
	</Grid>
