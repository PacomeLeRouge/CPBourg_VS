<UserControl x:Class="CPBourg.NextGenGui.Views.ScreenCalibrationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="{StaticResource CardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,12">
            <StackPanel>
                <TextBlock Text="Calibrate Touch Screen" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tap the centre of each target." FontSize="15" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Width="48" Height="48" Click="OnCancelClick">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" />
            </Button>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
            <Canvas x:Name="CalibrationCanvas" Width="900" Height="500"
                    Background="{StaticResource ScreenBackgroundBrush}">
                <Button x:Name="CalibrationTarget" Width="72" Height="72"
                        Background="Transparent" BorderThickness="0"
                        Click="OnTargetClick">
                    <Grid Width="64" Height="64">
                        <Ellipse Stroke="{StaticResource JobsAccentBrush}" StrokeThickness="4" />
                        <Ellipse Width="18" Height="18" Fill="{StaticResource JobsAccentBrush}" />
                        <Line X1="32" Y1="0" X2="32" Y2="64"
                              Stroke="{StaticResource JobsAccentBrush}" StrokeThickness="2" />
                        <Line X1="0" Y1="32" X2="64" Y2="32"
                              Stroke="{StaticResource JobsAccentBrush}" StrokeThickness="2" />
                    </Grid>
                </Button>
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="2" Margin="28,14,28,22">
            <TextBlock x:Name="CalibrationProgressText" Text="Target 1 of 4"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <Button HorizontalAlignment="Right" MinWidth="120" MinHeight="48"
                    Click="OnCancelClick">
                <TextBlock Text="Cancel" FontSize="15" FontWeight="Medium" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
